# --- Application Settings ---
PROJECT_NAME="Roxai"
ENV_MODE="development"
DEBUG=True

# --- Security (New) ---
# یک کلید امن برای رمزنگاری توکن‌ها (برای محیط لوکال همین کافیست)
SECRET_KEY="test_secret_key_change_me_in_prod_to_something_complex"

# --- PostgreSQL Settings ---
POSTGRES_USER=roxai_user
POSTGRES_PASSWORD=roxai_password
POSTGRES_DB=roxai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Connection String for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Redis Settings (New) ---
# برای ذخیره OTP و Rate Limit ضروری است
REDIS_URL=redis://localhost:6379

# --- Email Settings (SMTP) ---
# این بخش برای ارسال واقعی ایمیل است.
# فعلاً که ENV_MODE=development است، سیستم از این‌ها استفاده نمی‌کند و در کنسول چاپ می‌کند.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=samaniehsan780@gmail.com
# رمز عبور اپلیکیشن (App Password) باید از تنظیمات گوگل گرفته شود، نه رمز عادی جیمیل
SMTP_PASSWORD=hlidctzgoczdwfnh
SMTP_SENDER=no-reply@roxai.com

# --- SMS Settings ---
# فعلاً خالی می‌گذاریم چون نیازی ندارید
SMS_PROVIDER_API_KEY=""

# --- MinIO Settings ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET_NAME=roxai-assets

# --- Temporal Settings ---
DB=postgresql
DB_PORT=5432
POSTGRES_SEEDS=postgres
TEMPORAL_HOST=localhost:7233

# --- Google Auth ---
AUTH_GOOGLE_ID="1057509467667-7lor1o4hpb5krffvfgddfh8s6ddj8fct.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET=""