# --- Application Settings ---
PROJECT_NAME="Roxai"
ENV_MODE="development"
DEBUG=True

# --- PostgreSQL Settings (Used by Python & Docker Container) ---
POSTGRES_USER=roxai_user
POSTGRES_PASSWORD=roxai_password
POSTGRES_DB=roxai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Connection String for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# --- MinIO Settings (Used by Python & Docker Container) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
# Note: Python needs localhost, but Docker needs service name usually. 
# We keep localhost here for local development running outside docker.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET_NAME=roxai-assets

# --- Temporal Settings ---
# Temporal auto-setup uses these generic DB vars mapping internally
DB=postgresql
DB_PORT=5432
POSTGRES_SEEDS=postgres
TEMPORAL_HOST=localhost:7233


AUTH_GOOGLE_ID="1057509467667-7lor1o4hpb5krffvfgddfh8s6ddj8fct.apps.googleusercontent.com"
